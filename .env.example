# Copie para .env e preencha. O .env está no .gitignore: nunca o versione.
# Convenção de nomes: veja docs/glossario.md (termo fiscal em português, resto em inglês).

# ------------------------------------------------------------------
# Ambiente SEFAZ
# ------------------------------------------------------------------
# HOMOLOGACAO (padrão) ou PRODUCAO.
AMBIENTE=HOMOLOGACAO
# Trava dupla: PRODUCAO só é aceito com esta confirmação explícita.
# Testes automatizados recusam subir se AMBIENTE=PRODUCAO, independente deste valor.
PRODUCAO_CONFIRMED=false

# ------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=emissor
POSTGRES_USER=emissor
POSTGRES_PASSWORD=troque-esta-senha

# ------------------------------------------------------------------
# Fila (RabbitMQ)
# ------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=emissor
RABBITMQ_PASSWORD=troque-esta-senha

# ------------------------------------------------------------------
# Envio (ADR-0006)
# ------------------------------------------------------------------
# Quanto a chamada síncrona espera antes de devolver EM_PROCESSAMENTO.
SYNC_WAIT_SECONDS=15
# Intervalos entre consultas à SEFAZ. O último se repete até o limite de tentativas.
CONSULTA_BACKOFF_SECONDS=2,5,15,30

# ------------------------------------------------------------------
# Numeração e inutilização (ADR-0007)
# ------------------------------------------------------------------
# Prazo legal para inutilizar números abandonados: A CONFIRMAR.
# Deixe vazio até o prazo ser confirmado com a legislação vigente.
INUTILIZACAO_DEADLINE_DAYS=

# ------------------------------------------------------------------
# Certificados A1 (ADR-0008)
# ------------------------------------------------------------------
CERTIFICADOS_DIR=.certificados
# Avisa quando faltar este número de dias para o certificado vencer.
CERTIFICADO_EXPIRY_ALERT_DAYS=30

# Senha de cada .pfx, uma linha por CNPJ, no formato CNPJ_<cnpj>=senha.
# <cnpj> é o nome da subpasta em .certificados/: só letras maiúsculas e dígitos,
# sem pontuação. O CNPJ pode ser alfanumérico.
# CNPJ_00000000000000=senha-do-pfx
# CNPJ_12ABC34501DE35=senha-do-pfx
